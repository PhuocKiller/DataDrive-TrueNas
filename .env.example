# Sao chep thanh .env roi dien. KHONG commit file .env.

# --- Chi dung khi cai moi (install.sh) ---
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=
NC_DB_PASSWORD=
NC_REDIS_PASSWORD=
NC_HOST=storage.datadrive.vn
NC_PORT=30027
# ID chung chi TLS trong TrueNAS (Credentials -> Certificates). De trong = cert tu ky cua app.
NC_CERTIFICATE_ID=

# --- Dung cho apply-rebrand.sh ---
# Phai TRUNG voi DD_SSO_SECRET trong wp-config.php cua datadrive.vn
DD_SSO_SECRET=
# De trong = khong dung toi cau hinh email dang co
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=user@example.com
SMTP_PASSWORD=
