{
  "TZ": "Asia/Ho_Chi_Minh",
  "nextcloud": {
    "admin_user": "SET_BY_INSTALL",
    "admin_password": "SET_BY_INSTALL",
    "db_user": "nextcloud",
    "db_password": "SET_BY_INSTALL",
    "redis_password": "SET_BY_INSTALL",
    "host": "SET_BY_INSTALL",
    "data_dir_path": "/var/www/html/data",
    "postgres_image_selector": "postgres_18_image",
    "apt_packages": [],
    "tesseract_languages": [],
    "additional_envs": [],
    "imaginary": { "enabled": false },
    "cron": { "enabled": true, "schedule": "*/5 * * * *" },
    "max_execution_time": 30,
    "php_memory_limit": 512,
    "php_upload_limit": 3,
    "op_cache_memory_consumption": 128,
    "op_cache_interned_strings_buffer": 32
  },
  "network": {
    "certificate_id": null,
    "web_port": { "bind_mode": "published", "port_number": 30027, "host_ips": [] },
    "nginx": {
      "proxy_timeout": 1800,
      "use_different_port": false,
      "custom_confs": [],
      "trusted_proxies": ["127.0.0.1", "192.168.0.0/16", "172.16.0.0/12", "10.0.0.0/8"]
    },
    "networks": [],
    "dns_opts": []
  },
  "storage": {
    "html": { "type": "ix_volume", "ix_volume_config": { "acl_enable": false, "dataset_name": "html" } },
    "data": { "type": "ix_volume", "ix_volume_config": { "acl_enable": false, "dataset_name": "data" } },
    "postgres_data": { "type": "ix_volume", "ix_volume_config": { "acl_enable": false, "dataset_name": "postgres_data" } },
    "additional_storage": []
  },
  "resources": { "limits": { "cpus": 2, "memory": 4096 } },
  "labels": []
}
